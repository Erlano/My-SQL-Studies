CREATE DATABASE lista_prezentów;

CREATE TABLE prezenty_2020(
id INTEGER PRIMARY KEY AUTO_INCREMENT,
imie_obdarowanego TEXT,
pomysl_na_prezent TEXT,
cena NUMERIC (10,2),
miejsce_zakupu TEXT
);

